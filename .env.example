# Copy to .env. Everything is optional except where noted.

# Set this to get generated, cited answers from Claude. Without it /ask returns the best passages.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# sentence-transformers (semantic, downloads ~470 MB model on first run) or hashing (offline, lexical)
EMBEDDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200
MAX_UPLOAD_MB=25
